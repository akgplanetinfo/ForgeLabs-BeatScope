{
  "name": "forgelabs-beatscope",
  "productName": "ForgeLabs BeatScope",
  "version": "0.1.0",
  "description": "ForgeLabs BeatScope – valós idejű zenei vizualizátor Windowsra",
  "private": true,
  "main": "src/main.cjs",
  "author": "ForgeLabs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/ui.js && node --check src/audio-math.js && node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "team.forgelabs.beatscope",
    "productName": "ForgeLabs BeatScope",
    "asar": true,
    "files": ["index.html", "src/**/*", "assets/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "assets/beatscope.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ForgeLabs BeatScope",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ForgeLabs-BeatScope-Setup-${version}-${arch}.${ext}"
    },
    "portable": { "artifactName": "ForgeLabs-BeatScope-Portable-${version}-${arch}.${ext}" }
  }
}